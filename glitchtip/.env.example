# GlitchTip environment config — copy to .env and fill in values
# Never commit .env to version control

# --- Required ---
POSTGRES_PASSWORD=change_me_strong_password
SECRET_KEY=change_me_long_random_secret_key_50_chars_minimum

# --- Domain (used in links, emails) ---
GLITCHTIP_DOMAIN=http://localhost
# GLITCHTIP_DOMAIN=https://glitchtip.example.com

# --- Email (optional but recommended) ---
# consolemail:// → prints to Docker logs (good for testing)
# smtp://user:password@smtp.example.com:587
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=glitchtip@example.com



# create user with
# docker compose run --rm web ./manage.py createsuperuser

